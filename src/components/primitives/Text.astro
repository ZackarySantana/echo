---
interface Props {
    type: "heading" | "subheading" | "body" | "caption";
}

const { type } = Astro.props;
---

{
    type === "heading" && (
        <h1 class="text-3xl font-bold">
            <slot />
        </h1>
    )
}

{
    type === "subheading" && (
        <h2 class="text-xl font-semibold">
            <slot />
        </h2>
    )
}
