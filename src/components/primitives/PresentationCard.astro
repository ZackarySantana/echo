---
import Play from "@lucide/astro/icons/play";
import CirclePlus from "@lucide/astro/icons/circle-plus";

interface Props {
    id?: string;
    updatedAt?: Date;
    title?: string;
    subtitle?: string;
    image?: string;
    skeleton?: boolean;
}
const { title, image, subtitle, skeleton = false, id } = Astro.props;
let href = "/create-presentation";
if (id) {
    href = `/presentation/${id}`;
}
---

<a
    href={href}
    class="group relative hidden aspect-4/3 w-full flex-col overflow-hidden rounded-xl bg-linear-to-br from-gray-800 to-gray-900 transition-all hover:scale-[1.02] hover:shadow-xl sm:flex"
    class:list={{
        "cursor-pointer": href,
        "animate-pulse": skeleton,
    }}
>
    {
        skeleton ? (
            <>
                <div class="h-2/3 bg-linear-to-br from-gray-700 to-gray-800" />
                <div class="flex flex-1 items-center px-6">
                    <p class="text-sm font-semibold">New Presentation</p>
                </div>
                <CirclePlus class="absolute top-[calc(50%-40px)] left-[calc(50%-20px)] h-10 w-10 text-white" />
            </>
        ) : (
            <>
                {image ? (
                    <div class="h-2/3 overflow-hidden">
                        <img
                            src={image}
                            alt={title || "Presentation"}
                            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110"
                        />
                    </div>
                ) : (
                    <div class="h-2/3 bg-linear-to-br from-blue-400 to-blue-700" />
                )}
                <div class="flex flex-1 flex-col justify-center px-6">
                    <h3 class="text-sm font-semibold text-white">
                        {title || "Untitled Presentation"}
                    </h3>
                    {subtitle && (
                        <p class="mt-0.5 text-sm text-gray-400 italic">
                            {subtitle}
                        </p>
                    )}
                </div>
            </>
        )
    }
</a>

{
    !skeleton && (
        <a
            href={href}
            class="flex items-center gap-4 rounded-lg bg-gray-800/50 p-4 transition-all hover:bg-gray-800 active:bg-gray-700 sm:hidden"
        >
            {image ? (
                <div class="h-14 w-14 shrink-0 overflow-hidden rounded-lg">
                    <img
                        src={image}
                        alt={title || "Presentation"}
                        class="h-full w-full object-cover"
                    />
                </div>
            ) : (
                <div class="h-14 w-14 shrink-0 rounded-lg bg-linear-to-br from-blue-400 to-blue-700" />
            )}
            <div class="min-w-0 flex-1">
                <h3 class="truncate text-base font-semibold text-white">
                    {title || "Untitled Presentation"}
                </h3>
                {subtitle && (
                    <p class="mt-0.5 text-sm text-gray-400 italic">
                        {subtitle}
                    </p>
                )}
            </div>
            <div class="shrink-0">
                <Play class="h-6 w-6 text-gray-400" />
            </div>
        </a>
    )
}
