---
import Menu from "@lucide/astro/icons/menu";
import X from "@lucide/astro/icons/x";
import Settings from "@lucide/astro/icons/settings";
import ChevronLeft from "@lucide/astro/icons/chevron-left";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import SidebarItem from "./SidebarItem.astro";
---

<!-- Top bar - always visible, contains toggle and title -->
<div
    class="border-border-sidebar bg-bg-sidebar fixed top-0 right-0 left-0 z-50 flex h-16 items-center border-b px-4 sm:hidden"
>
    <div class="flex w-10 items-center justify-center">
        <button id="sidebar-toggle" type="button" aria-label="Toggle sidebar">
            <SidebarItem id="hamburger-icon" class="p-3">
                <Menu class="h-5 w-5" />
            </SidebarItem>
            <SidebarItem id="close-icon" class="hidden p-3">
                <X class="h-5 w-5" />
            </SidebarItem>
        </button>
    </div>
    <div class="flex-1 text-center">
        <slot name="title" />
    </div>
    <div class="flex w-10 items-center justify-center">
        <a href="/settings">
            <SidebarItem class="p-3">
                <Settings class="h-5 w-5" />
            </SidebarItem>
        </a>
    </div>
</div>

<!-- Sidebar content panel - slides in from left on mobile -->
<aside
    id="sidebar"
    class="bg-bg-sidebar border-border-sidebar fixed top-14 left-0 z-40 flex h-[calc(100vh-3.5rem)] w-dvw shrink-0 -translate-x-full flex-col border-r transition-transform duration-300 ease-in-out sm:sticky sm:top-0 sm:h-screen sm:w-64 sm:translate-x-0"
>
    <!-- Desktop header - only visible on desktop -->
    <div
        class="border-border-sidebar hidden h-16 shrink-0 items-center border-b px-6 sm:flex"
    >
        <div class="flex-1 text-left">
            <slot name="title" />
        </div>
        <div class="flex w-10 items-center justify-center">
            <a href="/settings">
                <SidebarItem class="p-3">
                    <Settings class="h-5 w-5" />
                </SidebarItem>
            </a>
        </div>
    </div>
    <div class="flex flex-1 flex-col gap-2 overflow-y-auto p-4">
        <slot />
        <div class="mt-auto">
            <slot name="footer" />
        </div>
    </div>

    <!-- Desktop collapse button - positioned on the right edge -->
    <button
        id="desktop-collapse-btn"
        type="button"
        class="bg-bg-sidebar border-border-sidebar absolute top-1/2 -right-3 hidden h-12 w-6 -translate-y-1/2 items-center justify-center rounded-r-lg border border-l-0 shadow-lg transition-all hover:w-7 sm:flex"
        aria-label="Collapse sidebar"
    >
        <ChevronLeft class="h-4 w-4 text-gray-400" />
    </button>
</aside>

<button
    id="desktop-expand-btn"
    type="button"
    class="bg-bg-sidebar border-border-sidebar fixed top-1/2 left-0 hidden h-12 w-6 -translate-y-1/2 items-center justify-center rounded-r-lg border border-l-0 shadow-lg transition-all hover:w-7 sm:flex"
    aria-label="Expand sidebar"
>
    <ChevronRight class="h-4 w-4 text-gray-400" />
</button>

<div
    id="sidebar-overlay"
    class="fixed inset-0 z-30 hidden bg-black/50 sm:hidden"
>
</div>

<script>
    const sidebar = document.getElementById("sidebar");
    const overlay = document.getElementById("sidebar-overlay");
    const toggleBtn = document.getElementById("sidebar-toggle");
    const hamburgerIcon = document.getElementById("hamburger-icon");
    const closeIcon = document.getElementById("close-icon");
    const desktopCollapseBtn = document.getElementById("desktop-collapse-btn");
    const desktopExpandBtn = document.getElementById("desktop-expand-btn");

    let isDesktopCollapsed = false;

    function openSidebar() {
        sidebar?.classList.remove("-translate-x-full");
        overlay?.classList.remove("hidden");
        hamburgerIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
    }

    function closeSidebar() {
        sidebar?.classList.add("-translate-x-full");
        overlay?.classList.add("hidden");
        hamburgerIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
    }

    function toggleDesktopSidebar() {
        isDesktopCollapsed = !isDesktopCollapsed;

        if (isDesktopCollapsed) {
            sidebar?.classList.add("hidden");
            sidebar?.classList.remove("sm:translate-x-0");
            desktopExpandBtn?.classList.remove("hidden");
        } else {
            sidebar?.classList.remove("hidden");
            sidebar?.classList.add("sm:translate-x-0");
            desktopExpandBtn?.classList.add("hidden");
        }
    }

    toggleBtn?.addEventListener("click", () => {
        if (sidebar?.classList.contains("-translate-x-full")) {
            openSidebar();
        } else {
            closeSidebar();
        }
    });

    desktopCollapseBtn?.addEventListener("click", toggleDesktopSidebar);
    desktopExpandBtn?.addEventListener("click", toggleDesktopSidebar);

    overlay?.addEventListener("click", closeSidebar);

    // Close sidebar on escape key
    document.addEventListener("keydown", (e) => {
        if (
            e.key === "Escape" &&
            !sidebar?.classList.contains("-translate-x-full")
        ) {
            closeSidebar();
        }
    });
</script>
