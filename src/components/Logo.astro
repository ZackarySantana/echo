---
import { Podcast } from "@lucide/astro";

interface Props {
    withSlogan?: boolean;
    size?: "large" | "medium";
}

const { withSlogan = false, size = "large" } = Astro.props;
---

<a href="/">
    {
        size === "medium" && (
            <div class="flex items-center justify-center gap-2 text-white">
                <Podcast class="h-6 w-6" />
                <h1 class="text-2xl font-bold">Echo</h1>
            </div>
        )
    }

    {
        size === "large" && (
            <div class="flex items-center justify-center gap-3 text-white">
                <Podcast class="h-10 w-10" />
                <h1 class="text-4xl font-bold">Echo</h1>
            </div>
        )
    }
</a>

{
    withSlogan && (
        <p class="text-xl font-medium tracking-wide">
            Interactive Presentations, Simplified.
        </p>
    )
}
