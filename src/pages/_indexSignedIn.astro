---
import PresentationCard from "../components/primitives/PresentationCard.astro";
import Text from "../components/primitives/Text.astro";
import LinkButton from "../components/primitives/LinkButton.astro";
import TextInput from "../components/primitives/TextInput.astro";
import MainSidebar from "../components/MainSidebar.astro";
import { ArrowRight } from "@lucide/astro";
---

<div class="flex">
    <MainSidebar />
    <main
        class="ml-0 flex w-full flex-col px-8 py-5 pt-20 sm:ml-10 sm:items-center sm:pt-10"
    >
        <Text type="heading" class="text-2xl sm:text-3xl">
            Join a Session
        </Text>

        <div
            class="flex w-full flex-col gap-3 pt-5 sm:flex-row sm:justify-center"
        >
            <TextInput
                placeholder="Enter Session Code"
                id="session-code"
                class="sm:w-[300px]"
            />
            <LinkButton
                href="/join"
                class="text-sm"
                class="join-button sm:hidden"
                primary
            >
                Join Session
            </LinkButton>
            <LinkButton
                href="/join"
                class="text-sm"
                class="join-button hidden sm:inline-block"
                primary
            >
                Join
            </LinkButton>
            <script>
                // Update the join button link based on input
                const input = document.getElementById(
                    "session-code",
                )! as HTMLInputElement;

                document.querySelectorAll(".join-button").forEach((button) => {
                    if (!(button instanceof HTMLAnchorElement)) return;
                    input.addEventListener("input", () => {
                        const code = input.value.trim();
                        button.href = code
                            ? `/join?code=${encodeURIComponent(code)}`
                            : "/join";
                    });
                });
            </script>
        </div>

        <div class="mt-10 flex w-full items-center justify-between">
            <Text type="heading" class="text-2xl sm:text-3xl">
                My Presentations
            </Text>
            <a
                href="/my-presentation"
                class="inline-block text-sm text-blue-400 transition-all hover:underline sm:hidden"
            >
                See all <ArrowRight class="inline-block h-4 w-4" />
            </a>
            <TextInput
                placeholder="Search my Presentations"
                id="search-my-presentations"
                class="hidden sm:inline-block sm:w-[300px]"
            />
        </div>
        <hr class="mt-4 w-full border-zinc-800" />
        <div
            class="flex w-full flex-col gap-3 pt-5 sm:grid sm:grid-cols-3 sm:flex-row sm:gap-5"
        >
            <PresentationCard id="testing" title="My first presentation" />
            <PresentationCard id="testing2" title="Solid" />
            <PresentationCard skeleton />
        </div>
        <a
            href="/my-presentation"
            class="mt-5 hidden text-sm text-blue-400 transition-all hover:underline sm:inline-block"
        >
            View all
        </a>

        <div class="mt-10 flex w-full items-center justify-between">
            <Text type="heading" class="text-2xl sm:text-3xl">Community</Text>
            <a
                href="/my-presentation"
                class="inline-block text-sm text-blue-400 transition-all hover:underline sm:hidden"
            >
                Explore <ArrowRight class="inline-block h-4 w-4" />
            </a>
            <TextInput
                placeholder="Search Community Presentations"
                id="search-community-presentations"
                class="hidden sm:inline-block sm:w-[300px]"
            />
        </div>
        <hr class="mt-4 w-full border-zinc-800" />
        <div
            class="flex w-full flex-col gap-3 pt-5 sm:grid sm:grid-cols-3 sm:flex-row sm:gap-5"
        >
            <PresentationCard id="testing" title="React" />
            <PresentationCard id="testing2" title="Firebase" />
            <PresentationCard id="testing3" title="How to present 101" />
        </div>
        <a
            href="/my-presentation"
            class="mt-5 hidden text-sm text-blue-400 transition-all hover:underline sm:inline-block"
        >
            Explore more
        </a>
    </main>
</div>
