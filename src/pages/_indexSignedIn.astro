---
import { LogOut, Podcast } from "@lucide/astro";
import Button from "../components/primitives/Button.astro";
import Sidebar from "../components/primitives/Sidebar.astro";
import SidebarItem from "../components/primitives/SidebarItem.astro";
import Text from "../components/primitives/Text.astro";
import Logout from "../components/primitives/Logout.astro";
import Logo from "../components/Logo.astro";
import LinkButton from "../components/primitives/LinkButton.astro";
import TextInput from "../components/primitives/TextInput.astro";
---

<div class="flex">
    <Sidebar>
        <div
            slot="title"
            class="flex w-full items-center justify-center gap-2 sm:justify-start"
        >
            <Logo size="medium" />
        </div>
        <p>Test</p>
        <Logout slot="footer" class="w-full">
            <SidebarItem>
                <LogOut class="h-5 w-5 shrink-0" />

                <span>Sign Out</span>
            </SidebarItem>
        </Logout>
    </Sidebar>
    <main
        class="ml-10 flex w-full flex-col px-8 py-5 pt-20 sm:ml-0 sm:items-center sm:pt-10"
    >
        <Text type="heading">Join a Session</Text>

        <div class="flex gap-5 pt-5">
            <TextInput placeholder="Enter Session Code" id="session-code" />
            <LinkButton href="/join" class="text-sm" id="join-button" primary>
                Join
            </LinkButton>
            <script>
                // Update the join button link based on input
                const input = document.getElementById(
                    "session-code",
                )! as HTMLInputElement;
                const button = document.getElementById(
                    "join-button",
                )! as HTMLAnchorElement;

                input.addEventListener("input", () => {
                    const code = input.value.trim();
                    button.href = code
                        ? `/join?code=${encodeURIComponent(code)}`
                        : "/join";
                });
            </script>
        </div>
    </main>
</div>
