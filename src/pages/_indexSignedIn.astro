---
import Text from "../components/primitives/Text.astro";
import LinkButton from "../components/primitives/LinkButton.astro";
import TextInput from "../components/primitives/TextInput.astro";
import MainSidebar from "../components/MainSidebar.astro";
---

<div class="flex">
    <MainSidebar />
    <main
        class="ml-0 flex w-full flex-col items-center px-8 py-5 pt-20 sm:ml-10 sm:pt-10"
    >
        <Text type="heading">Join a Session</Text>

        <div class="flex w-full flex-col gap-3 pt-5 sm:flex-row">
            <TextInput
                placeholder="Enter Session Code"
                id="session-code"
                class="sm:w-[300px]"
            />
            <LinkButton
                href="/join"
                class="text-sm"
                class="join-button sm:hidden"
                primary
            >
                Join Session
            </LinkButton>
            <LinkButton
                href="/join"
                class="text-sm"
                class="join-button hidden sm:inline-block"
                primary
            >
                Join
            </LinkButton>
            <script>
                // Update the join button link based on input
                const input = document.getElementById(
                    "session-code",
                )! as HTMLInputElement;

                document.querySelectorAll(".join-button").forEach((button) => {
                    if (!(button instanceof HTMLAnchorElement)) return;
                    input.addEventListener("input", () => {
                        const code = input.value.trim();
                        button.href = code
                            ? `/join?code=${encodeURIComponent(code)}`
                            : "/join";
                    });
                });
            </script>
        </div>
    </main>
</div>
