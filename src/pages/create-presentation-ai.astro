---
import Layout from "../layouts/Layout.astro";
import MainSidebar from "../components/MainSidebar.astro";
import Text from "../components/primitives/Text.astro";
import TextArea from "../components/primitives/TextArea.astro";
import LinkButton from "../components/primitives/LinkButton.astro";

const { user } = Astro.locals;
---

<Layout class="flex">
    <MainSidebar />

    <main class="flex w-full flex-col gap-4 p-8">
        <Text type="heading" class="mt-4">Create Presentation</Text>

        <TextArea
            placeholder="Enter presentation topic..."
            class="mt-2"
            id="presentation-input"
        />

        <LinkButton class="w-fit" id="generate-presentation">
            Generate
        </LinkButton>

        <script>
            const input = document.getElementById(
                "presentation-input",
            ) as HTMLTextAreaElement;
            const button = document.getElementById(
                "generate-presentation",
            ) as HTMLAnchorElement;

            input?.addEventListener("input", () => {
                button.href = `/presentation-ai?topic=${encodeURIComponent(
                    input.value,
                )}`;
            });
        </script>
    </main>
</Layout>
