---
import { setOpenRouterAPIKey } from "../../../lib/db";

const code = Astro.url.searchParams.get("code");
const { user } = Astro.locals;

if (!code) {
    return Astro.redirect("/404");
}

const response = await fetch("https://openrouter.ai/api/v1/auth/keys", {
    method: "POST",
    headers: {
        "Content-Type": "application/json",
    },
    body: JSON.stringify({
        code: code,
        // code_verifier: '<CODE_VERIFIER>', // If code_challenge was used
        // code_challenge_method: '<CODE_CHALLENGE_METHOD>', // If code_challenge was used
    }),
});

const { key } = await response.json();

await setOpenRouterAPIKey(user.id, key);

return Astro.redirect("/settings");
---
