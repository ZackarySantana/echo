---
import { localsUser } from "../../../lib/auth";
import { setChatGPTAPIKey } from "../../../lib/db";

const key = Astro.url.searchParams.get("key");
const [user, resp] = localsUser(Astro.locals);
if (resp) {
    return resp;
}

console.log("Key");
console.log(key);
console.log("key end");
if (!key || key.length === 0) {
    return Astro.redirect("/settings");
}

await setChatGPTAPIKey(user.id, key);

return Astro.redirect("/settings");
---
