---
import Layout from "../layouts/Layout.astro";
import Text from "../components/primitives/Text.astro";
import MainSidebar from "../components/MainSidebar.astro";
import LinkButton from "../components/primitives/LinkButton.astro";
import { getOptionalUser } from "../lib/db";
import TextInput from "../components/primitives/TextInput.astro";
import ExternalLink from "@lucide/astro/icons/external-link";
import Link2Off from "@lucide/astro/icons/link-2-off";
import { localsUser } from "../lib/auth";

const error = Astro.url.searchParams.get("error");

const [user, resp] = localsUser(Astro.locals);
if (resp) {
    return resp;
}

const redirect = `https://openrouter.ai/auth?callback_url=${Astro.url.origin}/oauth/openrouter/callback`;

if (false) {
    // redirect += "&code_challenge=<CODE_CHALLENGE>&code_challenge_method=S256"
}

let hasOpenRouterKey = false;
let hasChatGPTKey = false;

const dbUserResp = await getOptionalUser(user.id);
if (dbUserResp) {
    const [user, err] = dbUserResp;
    if (err) {
        return err;
    }
    hasOpenRouterKey = user.openRouterAPIKey !== null;
    hasChatGPTKey = user.chatGPTAPIKey !== null;
}
---

<Layout class="flex">
    <MainSidebar>
        <main class="flex w-full flex-col px-8">
            <Text type="heading" class="mt-4">Settings Page</Text>
            <Text type="body" class="mt-2">
                Set various preferences for your account and application.
            </Text>

            {
                error && (
                    <div class="mt-4 max-w-full rounded-md bg-red-600/10 p-4 wrap-break-word text-red-400">
                        {error}
                    </div>
                )
            }

            <div class="mt-10 flex flex-col gap-6">
                <Text type="heading">Integrations</Text>
                <div class="flex flex-col gap-2">
                    <Text type="subheading">OpenRouter</Text>
                    {
                        !hasOpenRouterKey ? (
                            <LinkButton
                                href={redirect}
                                class="flex items-center justify-center gap-2 sm:w-fit"
                            >
                                Connect
                                <ExternalLink class="h-5 w-5" />
                            </LinkButton>
                        ) : (
                            <LinkButton
                                href={"/oauth/openrouter/delete"}
                                class="flex items-center justify-center gap-2 sm:w-fit"
                            >
                                Disconnect
                                <Link2Off class="h-5 w-5" />
                            </LinkButton>
                        )
                    }
                </div>
                <div class="flex flex-col gap-2">
                    <Text type="subheading">ChatGPT</Text>

                    {
                        !hasChatGPTKey && (
                            <div class="flex flex-col justify-center gap-2 sm:flex-row sm:items-center sm:justify-start">
                                <TextInput
                                    placeholder="Enter ChatGPT API key"
                                    id="chat-gptapi-key"
                                />
                                <LinkButton
                                    class="sm:w-fit"
                                    id="chatgpt-button"
                                    href="/oauth/chatgpt/delete"
                                >
                                    Save
                                </LinkButton>
                            </div>
                        )
                    }
                    {
                        hasChatGPTKey && (
                            <LinkButton
                                href="/oauth/chatgpt/delete"
                                class="flex items-center justify-center gap-2 sm:w-fit"
                            >
                                Disconnect
                                <Link2Off class="h-5 w-5" />
                            </LinkButton>
                        )
                    }

                    <script>
                        const input = document.getElementById(
                            "chat-gptapi-key",
                        )! as HTMLInputElement;
                        const button = document.getElementById(
                            "chatgpt-button",
                        )! as HTMLAnchorElement;

                        input?.addEventListener("input", () => {
                            button.href = `/oauth/chatgpt/set?key=${encodeURIComponent(
                                input.value.trim(),
                            )}`;
                        });
                    </script>
                </div>
            </div>
        </main>
    </MainSidebar>
</Layout>
