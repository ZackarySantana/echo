---
import Logo from "../components/Logo.astro";
import Card from "../components/primitives/Card.astro";
import LinkButton from "../components/primitives/LinkButton.astro";
import TextInput from "../components/primitives/TextInput.astro";
import Layout from "../layouts/Layout.astro";

const user = Astro.locals.publicPageUser;
---

<Layout centerItems>
    <Logo />
    <p class="text-xl font-medium tracking-wide">
        Interactive Presentations, Simplified.
    </p>
    <Card class="mt-5 sm:min-w-[550px]">
        <LinkButton href="/sign-up" primary>Sign Up for an Account</LinkButton>
        <p
            class="mx-auto max-w-[300px] pt-2 pb-4 text-center text-sm tracking-wider text-wrap text-neutral-400 sm:max-w-full"
        >
            Create an account to save and manage your presentations.
        </p>
        <div slot="or">
            <p class="text-center">
                Joining a session? Enter your code to continue.
            </p>
            <div class="flex items-center justify-center gap-2 pt-4">
                <TextInput placeholder="Enter Session Code" id="session-code" />
                <LinkButton href="/join" class="text-sm" id="join-button"
                    >Join</LinkButton
                >
                <script>
                    // Update the join button link based on input
                    const input = document.getElementById(
                        "session-code",
                    )! as HTMLInputElement;
                    const button = document.getElementById(
                        "join-button",
                    )! as HTMLAnchorElement;

                    input.addEventListener("input", () => {
                        const code = input.value.trim();
                        button.href = code
                            ? `/join?code=${encodeURIComponent(code)}`
                            : "/join";
                    });
                </script>
            </div>
        </div>
    </Card>
</Layout>
