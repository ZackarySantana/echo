---
import "./global.css";

interface Props {
    title?: string;
}

const { title = "Echo - Interactive Presentations" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap"
            rel="stylesheet"
        />

        <script>
            import { defineCustomElement } from "echo-wc/my-component";

            defineCustomElement();
        </script>
    </head>
    <body
        class="bg-bg text-bg-text h-full min-h-dvh w-full font-['Inter',sans-serif]"
    >
        <slot />
    </body>
</html>
