---
import "./global.css";

interface Props {
    title?: string;
}

const { title = "Echo - Interactive Presentations" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png"
        />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap"
            rel="stylesheet"
        />

        <script>
            import { defineCustomElement } from "echo-wc/my-component";

            defineCustomElement();
        </script>
    </head>
    <body
        class="bg-bg text-bg-text h-full min-h-dvh w-full font-['Inter',sans-serif]"
    >
        <slot />
    </body>
</html>
